static func point(pair: Array) -> Vector2:
	return ART.position + Vector2(pair[0], pair[1]) / SKETCH * ART.size

static func line(points: Array) -> PackedVector2Array:
	var result := PackedVector2Array()
	for pair in points:
		result.append(point(pair))
	return result

static func polygons(sets: Array) -> Array[PackedVector2Array]:
	var result: Array[PackedVector2Array] = []
	for pairs in sets:
		result.append(line(pairs))
	return result
