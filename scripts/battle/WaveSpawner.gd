extends RefCounted

const WAVES := [
	[
		[[1,0,2],[3,0,0],[5,0,2],[7,0,1],[9,1,0],[12,0,1],[14,0,0],[17,1,2],[20,0,2],[23,0,1],[25,1,0],[29,0,0],[31,0,1],[33,0,2],[35,2,1],[39,1,2],[43,0,0],[45,0,1],[47,1,2]],
		[[1,0,0],[2,0,2],[5,1,1],[8,0,0],[10,2,2],[13,0,1],[16,1,0],[18,3,2],[22,0,1],[24,0,2],[27,1,0],[30,2,1],[33,4,0],[36,0,1],[38,1,2],[42,2,0],[45,0,2],[47,1,1]]
	],
	[
		[[1,0,0],[3,0,2],[5,1,1],[8,0,0],[11,2,2],[14,0,0],[17,3,1],[20,1,2],[24,0,2],[27,4,1],[31,2,1],[35,1,0],[40,3,2],[45,0,0]],
		[[1,1,2],[2,0,1],[4,0,0],[7,4,2],[10,2,1],[14,3,0],[18,1,1],[20,0,2],[23,2,2],[27,4,0],[31,1,1],[36,3,2],[40,0,0],[45,2,1]]
	],
	[
		[[1,0,1],[3,0,0],[5,1,2],[8,0,1],[11,2,2],[14,1,0],[16,3,1],[20,0,2],[24,4,0],[27,2,2],[31,1,1],[36,2,0],[42,3,2],[45,0,1]],
		[[1,1,2],[2,0,1],[4,0,0],[6,4,2],[10,2,1],[14,3,0],[18,1,1],[20,0,2],[23,2,2],[27,4,0],[31,1,1],[36,3,2],[40,0,0],[45,2,1],[47,1,0]]
	],
	[
		[[1,0,0],[3,0,2],[5,1,1],[8,0,0],[11,2,2],[14,4,0],[17,3,1],[20,1,2],[24,4,2],[27,1,1],[31,2,1],[35,1,0],[40,3,2],[45,2,0]],
		[[1,1,2],[2,0,1],[4,0,0],[7,4,2],[10,2,1],[14,3,0],[18,1,1],[20,0,2],[23,2,2],[27,4,0],[31,1,1],[36,3,2],[40,0,0],[45,2,1],[48,4,2]]
	]
]

var schedule: Array = []
var cursor := 0

func prepare(biome: int, night_number: int, elite: bool, boss: bool, cycle: int) -> void:
	schedule = WAVES[biome][night_number - 1].duplicate(true)
	if elite:
		schedule.append([16, 3, 1])
		schedule.append([28, 4, 2])
	if boss and night_number == 2:
		schedule.append([26, 5, 0])
	var bonus := mini(cycle - 1, 7)
	for index in range(bonus):
		schedule.append([8 + index * 5, 1 + index % 4, index % 3])
	schedule.sort_custom(func(a, b): return a[0] < b[0])
	cursor = 0

func release(age: float, spawn: Callable) -> void:
	while cursor < schedule.size() and age >= float(schedule[cursor][0]):
		var arrival: Array = schedule[cursor]
		spawn.call(int(arrival[1]), int(arrival[2]))
		cursor += 1

func remaining() -> int:
	return schedule.size() - cursor
